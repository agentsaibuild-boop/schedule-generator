ANTHROPIC_API_KEY=sk-ant-your-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# По подразбиране: директно към DeepSeek. За OpenRouter разкоментирай:
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_MODEL=deepseek/deepseek-chat
#
# ПРЕПОРЪЧАН РЕЖИМ — Claude Sonnet 5 през OpenRouter (без Anthropic директни
# кредити; плаща се от OpenRouter).  DEEPSEEK_BASE_URL е ЗАДЪЛЖИТЕЛЕН — без него
# кодът праща anthropic/claude-sonnet-5 към api.deepseek.com и се проваля:
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_MODEL=anthropic/claude-sonnet-5   # (или deepseek/deepseek-v4-flash — ~10× по-евтино)
# ANALYSIS_MAX_TOKENS=16000   # таван на анализа (иначе под-покритие)
#
# ТАВАН НА ИЗХОДА.  WORKER_MAX_TOKENS (по подразбиране 16000) важи за ДВАТА
# клона на работника и генерирането го наследява — едно копче, не две.
# Прогоните 10.08.2026 се правеха с твърди 8192 и 11 отговора излязоха
# отрязани; при голям търг вдигни ТАЗИ променлива:
# WORKER_MAX_TOKENS=32000
# GEN_MAX_TOKENS=32000        # само ако генерирането трябва да се РАЗМИНЕ с горната
#
# Работник с ТВЪРД таван (DeepSeek V3 директно) отхвърля заявка над него —
# тогава кодът сам слиза на 8192 и го пише в лога.  Ако отрязването продължи,
# проектът се дели на етапи; вдигането на тавана няма да помогне.
# MAX_ROWS_PER_PART=50        # авто при Claude worker; ръчно за други
# OCR иска vision модел — работникът (DeepSeek) е text-only.
# Празно = ползва работника (OCR няма да работи). Цените са USD за 1M токена.
# OCR_MODEL=mistralai/mistral-small-3.2-24b-instruct
# OCR_PRICE_IN=0.10
# OCR_PRICE_OUT=0.30
ADMIN_CODE=your-admin-code-here
APP_PASSWORD=your-app-password-here

# Самопромяна на приложението (self-evolution) — ИЗКЛЮЧЕНА по подразбиране.
# Позволява на AI да пише в кода на приложението, в същия процес, който
# обработва тръжни документи и държи API ключовете. Изключена след одит
# на 2026-07-23. НЕ включвай на машина с реални документи/production ключове.
# ENABLE_SELF_EVOLUTION=1

# Пакетна генерация (по подразбиране включена).
# 1 = моделът връща физически участъци, а кодът строи веригите и WBS-а
#     (устройството на човешкия еталонен график).
# 0 = старият път: моделът връща направо плосък списък задачи.
PACKAGE_GENERATION=1

# Модел за четене на ситуационни чертежи (vision).
# ВНИМАНИЕ (2026-08-07): `mistralai/mistral-small-3.2-24b-instruct` е
# vision-способен, но OpenRouter го насочва към доставчик БЕЗ vision
# ("Image content is not supported by this model") и извличането се проваля.
# Проверено работещо: google/gemini-3.6-flash — 11 отсечки от реален чертеж.
OCR_MODEL=google/gemini-3.6-flash

# Извличане на ОТСЕЧКИ (клон + възли РШ/ОТ) от ситуацията — без тях пакетите
# не могат да се кръстят като в еталонния график. 0 = изключено.
SITUATION_SEGMENTS=1

# Колко пъти да се допита за неразпределени КСС позиции (0 = без допитване).
PACKAGE_REPAIR_ROUNDS=2
