# Environment
.env
.env.company
# Всяко копие на .env също (13.08.2026: резервно копие с ключове
# стоеше видимо за `git add -A`, защото се игнорираше само точното име).
.env*
venv/

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Output
output/
*.pdf
*.xml

# Streamlit secrets
.streamlit/secrets.toml

# Claude Code internals
.claude/

# Temp test scripts
_tmp_test.py
_generate_novi_iskar.py
_export_xml_novi_iskar.py
_test_enrich.py

# Test logs
tests/e2e/*.log

# Installer tools
tools/python-installer.exe

# Runtime data (user-specific, not shared)
config/cumulative_usage.json

# Test artifacts
tests/e2e/screenshots/

# Конвертирани документи на КЛИЕНТСКИ проекти (одит v11 #9) — съдържат
# извлечените количества/текст от тръжните документи.  НЕ в git.
converted/

# Note: These files ARE tracked (needed for installer):
#   install.bat, start.bat, update.bat
#   .env.example, .env.company.example
#   README_INSTALL.md, .streamlit/config.toml
#   tools/README.md
API's.env.txt

# Claude Code personal permissions (local only)
.claude/settings.local.json

# Virtual env (this session used .venv, not venv)
.venv/

# Данни, специфични за машината/клиента — машинни пътища, имена на реални
# проекти, история на чата.  Одит v11 #9: тези ДВА файла остават tracked в git
# история — извади ги с `git rm --cached <файл>` (иска изрично разрешение).
config/projects_history.json
config/project_summary.json

# Имена на клиентски обекти за анонимизиране — НЕ в git
config/client_names.local.json

# Прогоните: телеметрията влиза в git, суровините НЕ.
# `_подготовка.json` е кеширан анализ на тръжните документи (количества по DN,
# улици, име на обекта), `_дневник.txt` е логът от серията с улици в него.
# И двата се регенерират от tools/rerun_series.py при всяко пускане.
docs/прогони/_подготовка.json
docs/прогони/_дневник.txt
# Изпратените пакети носят името на обекта (проверено: 8 файла в първия).
# Влизат в git чак СЛЕД пренаписването на историята — иначе връщаме обратно
# точно това, което тя ще чисти.
docs/пратки/*.zip

# Кешът с тарифите на доставчика се тегли наново при нужда — не е резултат.
docs/бенчмарк/цени.json

# Оттеглени работни артефакти от прогоните: носят името на обекта.
docs/прогони/_подготовка-*.json
